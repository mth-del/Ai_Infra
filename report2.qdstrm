    color: "#FFC425"
  - name: L2 Throughput
    category: Unit Throughputs
    shortName: L2
    sku: public
    id: LTS.TriageAC.lts__throughput.avg.pct_of_peak_sustained_elapsed
    storageType: uint8
    color: "#00AEDB"
  - name: VRAM Throughput
    category: Unit Throughputs
    shortName: VRAM
    sku: public
