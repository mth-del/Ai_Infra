- name: Graphics Throughput Metrics for NVIDIA TU10x (frequency >= 10kHz)
  alias: tu10x-gfxt
  supportedChips: [TU102, TU104, TU106]
  counterWidth: narrow
  displayRows:
  - name: <Root>
    description: GPU Metrics
    displayHeightScale: 0.5
    metrics:
    - GPU Active
    - Async Copy Engine Active
    - Sync Copy Engine Active
    - GR Active
    type: overlay
  - name: <Root>
    displayHeightScale: -0.5
    metrics:
    - VRAM Read Throughput
    - VRAM Write Throughput
    - PCI Read Throughput
    - PCI Write Throughput
    type: overlay
  - name: GPU Active
    description: The graphics or copy engine is active
    metrics:
    - GPU Active
    - Async Copy Engine Active
    - Sync Copy Engine Active
    - GR Active
    type: overlay
  - name: Unit Throughputs
    description: Throughput of each major hardware unit
    metrics:
    - SM Throughput
    - L1TEX Throughput
    - L2 Throughput
    - VRAM Throughput
    - PCI Throughput
    - PD Throughput
    - VAF Throughput
    - PES+VPC Throughput
    - RASTER Throughput
    - PROP Throughput
    - ZROP Throughput
    - CROP Throughput
    type: overlay
  - name: Compute In Flight
    description: Compute dispatches sent to the DIRECT or ASYNC_COMPUTE Queues that have been issued, but not yet complete
    metrics:
    - Sync Compute In Flight
    - Async Compute In Flight
    type: overlay
  - name: Draw/Dispatch Start
    description: Draw and dispatch start times
    metrics:
    - Draw Started
    - Dispatch Started
    type: overlay
  - name: SM Occupancy (TPC View)
    description: SM Occupancy (TPC View)
    metrics:
    - Vertex/Tess/Geometry Warps
    - Pixel Warps
    - Compute Warps
    - Unallocated Warps in Active SMs
    type: stacked
  - name: SM Instructions
    description: SM Instructions
    metrics:
    - SM Issue Active
    - SM ALU Pipe Throughput
    - SM FMA Pipe Throughput
    - SM FP16+Tensor Pipe Throughput
    - SM SFU Pipe Throughput
    type: overlay
  - name: SM Warp Can't Launch
    description: Warp can't launch reasons
    metrics:
    - SM Pixel Warp Can't Launch
    - SM Pixel Warp Can't Launch, Register Limited
    - SM Compute Warp Can't Launch, Register Limited
    type: overlay
  - name: L1TEX Throughput
    description: L1TEX Cache pipeline breakdown
    metrics:
    - L1TEX LSU Data Throughput
    - L1TEX LSU Writeback Throughput
    - L1TEX Texture Data Throughput
    - L1TEX Texture Filter Stage Throughput
    type: overlay
  - name: L1TEX LSU Traffic
    description: L1TEX LSU traffic breakdown by memory space
    metrics:
    - L1TEX Local+Global Data Throughput
    - L1TEX Shared+Attribute Data Throughput
    type: stacked
  - name: L2 Traffic
    description: L2 traffic breakdown by source unit
    metrics:
    - L2 Bandwidth from CROP
    - L2 Bandwidth from L1TEX
    - L2 Bandwidth from ZROP
    type: stacked
  - name: L2 Read Hit Rates
    description: L2 hit rates for all read operations, and for read operations from L1TEX
    metrics:
    - L2 Read Hit Rate
    - L2 Read Hit Rate from L1TEX
    type: overlay
  - name: VRAM Bandwidth
    description: DRAM Bandwidth read/write
    metrics:
    - VRAM Read Throughput
    - VRAM Write Throughput
    type: stacked
  - name: PCI Bandwidth
    description: PCI bandwidth read/write
    metrics:
    - PCI Read Throughput
    - PCI Write Throughput
    type: overlay
  - name: PCIe Read Requests to BAR1
    metrics:
    - PCIe Read Requests to BAR1
    type: overlay
  - name: PCIe Write Requests to BAR1
    metrics:
    - PCIe Write Requests to BAR1
    type: overlay
  metrics:
  - name: GPU Active
    category: engine activity
    color: '#33B2B2'
    id: FE_A.TriageA.gpu__engine_cycles_active_gr_or_ce.avg.pct_of_peak_sustained_elapsed
    storageType: uint8
  - name: Sync Copy Engine Active
    category: engine activity
